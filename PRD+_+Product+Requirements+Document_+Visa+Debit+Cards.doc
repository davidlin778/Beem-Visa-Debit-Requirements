<h3 local-id=3D"c28b41fcbdc3" id=3D"PRD|ProductRequirementsDocument:VisaDeb=
itCards-3.CardMaintenance">3. Card Maintenance</h3>
<div id=3D"expander-719199435" class=3D"expand-container">
<div id=3D"expander-control-719199435" class=3D"expand-control">
<span class=3D"expand-control-icon"><img style=3D"vertical-align:middle;" c=
lass=3D"expand-control-image" src=3D"c07bcdf0ced7b4d9093bebfbefa7168e923321=
ffd7300a885255d320adb1d0df" width=3D"16" height=3D"16"></span><span class=
=3D"expand-control-text">Functional Requirements &amp; Acceptance Criteria<=
/span>
</div>
<div id=3D"expander-content-719199435" class=3D"expand-content">
<div class=3D"table-wrap">
<table data-table-width=3D"4000" data-layout=3D"align-start" data-local-id=
=3D"cb067f83-3769-4bc7-9c62-3bca41dcc434" class=3D"confluenceTable">
<colgroup>
<col style=3D"width: 55.0px;">
