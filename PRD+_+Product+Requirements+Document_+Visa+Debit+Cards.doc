<col style=3D"width: 69.0px;">
<col style=3D"width: 67.0px;">
<col style=3D"width: 60.0px;">
</colgroup>
<tbody>
<tr data-local-id=3D"238ad96a4e8d">
<th data-local-id=3D"578cc17d1f16" class=3D"confluenceTh">
<p local-id=3D"9fddc5b9b713"><strong>#</strong></p></th>
<th data-local-id=3D"428d8c683477" class=3D"confluenceTh">
<p local-id=3D"c022cb26290e"><strong>User Story</strong></p></th>
<th data-local-id=3D"f9caf2e37f59" class=3D"confluenceTh">
<p local-id=3D"7e24def251f8"><strong>Functional Requirement</strong></p></t=
h>
<th data-local-id=3D"965c9f8009b7" class=3D"confluenceTh">
<p local-id=3D"fa9ab517c78c"><strong>Acceptance Criteria</strong></p></th>
<th data-local-id=3D"f4d4a313c803" class=3D"confluenceTh">
<p local-id=3D"36fcce894ba4"><strong>Owner/Teams</strong></p></th>
<th data-local-id=3D"07534e841da8" class=3D"confluenceTh">
<p local-id=3D"3e34009f39f3"><strong>Priority</strong></p></th>
<th data-local-id=3D"719decf2357c" class=3D"confluenceTh">
<p local-id=3D"270d29edbe6e"><strong>Jira</strong></p></th>
</tr>
<tr data-local-id=3D"388b081cf38b">
<td data-local-id=3D"31a539dad6b1" class=3D"confluenceTd">
<p local-id=3D"285556fdf849"></p></td>
<td data-local-id=3D"806e41f049e2" class=3D"confluenceTd">
<p local-id=3D"81f25e54333e"></p></td>
<td data-local-id=3D"b0726bf28695" class=3D"confluenceTd">
<p local-id=3D"87a124f75196">Support end-to-end dispute lifecycle mgmt incl=
uding intake, investigation, tracking, resolution, and closure for all disp=
ute types.</p></td>
<td data-local-id=3D"dcc93e1ed8f1" class=3D"confluenceTd">
<p local-id=3D"db65336ca676">Need to note all possible dispute types for Vi=
sa Debit txns.</p>
<p local-id=3D"c93427b2f688">Pending vs Settled</p>
<p local-id=3D"52c7b18f9ffa">Interac vs Visa</p></td>
<td data-local-id=3D"7f8401651c73" class=3D"confluenceTd">
<p local-id=3D"12517eef2c1a"></p></td>
<td data-local-id=3D"a9c206cfa0b8" class=3D"confluenceTd">
<p local-id=3D"8aadb6e44b7d"></p></td>
<td data-local-id=3D"2e06dd085926" class=3D"confluenceTd">
<p local-id=3D"e6030240d0bd"></p></td>
</tr>
<tr data-local-id=3D"8b76443da223">
<td data-local-id=3D"8784f4c17e5c" class=3D"confluenceTd">
<p local-id=3D"e8e853a407da"></p></td>
<td data-local-id=3D"1641637d6a3f" class=3D"confluenceTd">
<p local-id=3D"cea7332ef835"></p></td>
<td data-local-id=3D"fe26067a4289" class=3D"confluenceTd">
<p local-id=3D"c93366bb7b04">Dispute mgmt platform integrates with Visa Res=
olve Online (VROL) for chargeback submission, fraud reporting, evidence exc=
hange, and resolution processing</p></td>
<td data-local-id=3D"fcac3a5cd963" class=3D"confluenceTd">
<p local-id=3D"86ae5ab5a3d5">The existing dispute process for Interac netwo=
rk will continue as it is today.</p></td>
<td data-local-id=3D"b5331090e41e" class=3D"confluenceTd">
<p local-id=3D"2ccb1a34f0fb"></p></td>
<td data-local-id=3D"b29da05f2209" class=3D"confluenceTd">
<p local-id=3D"a5135ff75a60"></p></td>
<td data-local-id=3D"98d4d7353f18" class=3D"confluenceTd">
<p local-id=3D"04925d3fcdf5"></p></td>
</tr>
<tr data-local-id=3D"c4877f491211">
<td data-local-id=3D"3f691de703b7" class=3D"confluenceTd">
<p local-id=3D"4c8b4c56e714"></p></td>
<td data-local-id=3D"42f73ea6a268" class=3D"confluenceTd">
<p local-id=3D"fc8c42f07236"><strong>As a</strong> system user,</p>
<p local-id=3D"a5ddba7835f8"><strong>I want to</strong> block subsequent fr=
aud claims associated with a PAN</p>
<p local-id=3D"5638515c24cd"><strong>So that I </strong>the initial fraud c=
laim can be investigated first.</p></td>
<td data-local-id=3D"ccd197ecb14a" class=3D"confluenceTd">
<p local-id=3D"b2b42708dc7b">Ability to block subsequent fraud claims by PA=
N after first confirmed fraud chargeback.</p></td>
<td data-local-id=3D"e98eadfb5f50" class=3D"confluenceTd">
<p local-id=3D"d5a306305961"></p></td>
<td data-local-id=3D"761e06322a43" class=3D"confluenceTd">
<p local-id=3D"88e8c3f411cb"></p></td>
<td data-local-id=3D"6cbb867e0242" class=3D"confluenceTd">
<p local-id=3D"1d0ab05e2f1d"></p></td>
<td data-local-id=3D"e0b1a17f82b2" class=3D"confluenceTd">
<p local-id=3D"af8a9a25d1a4"></p></td>
</tr>
<tr data-local-id=3D"5d8a7470834d">
<td data-local-id=3D"b109760c5210" class=3D"confluenceTd">
<p local-id=3D"2f0f6cc9cefa"></p></td>
<td data-local-id=3D"438ea522074a" class=3D"confluenceTd">
<p local-id=3D"7e74655095b3"><strong>As a</strong> system user,</p>
<p local-id=3D"36cda79d78b5"><strong>I want to</strong> stop any future rec=
urring transactions from being authorized,</p>
<p local-id=3D"3ee85e65b8fa"><strong>So that </strong>no future transaction=
s can be debited from a member=E2=80=99s account by a merchant.</p></td>
<td data-local-id=3D"1243cf412c9e" class=3D"confluenceTd">
<p local-id=3D"e0abfd5bda19">Ability to prevent future recurring charges fr=
om processing for card-on-file disputes.</p></td>
<td data-local-id=3D"491397817566" class=3D"confluenceTd">
<p local-id=3D"8051e4a7b51c">Transaction particulars shall be entered into =
the Visa Payment Cancellation database to prevent future recurring charges =
from the merchant</p></td>
<td data-local-id=3D"d32458050efb" class=3D"confluenceTd">
<p local-id=3D"a2285afb521a"></p></td>
<td data-local-id=3D"3d7553042ec7" class=3D"confluenceTd">
<p local-id=3D"cfe57038a0cc"></p></td>
<td data-local-id=3D"9512ad839446" class=3D"confluenceTd">
<p local-id=3D"b0c8d76d3290"></p></td>
</tr>
<tr data-local-id=3D"ce0bff6713a1">
<td data-local-id=3D"a2af92816b56" class=3D"confluenceTd">
<p local-id=3D"64ce9168bd77"></p></td>
<td data-local-id=3D"1390e6844d29" class=3D"confluenceTd">
<p local-id=3D"9b1f509d51f2"><strong>As a</strong> system user,</p>
<p local-id=3D"d67f4c207bb9"><strong>I want to</strong> easily identify the=
 authentication method used to approve a transaction,</p>
<p local-id=3D"c75623582141"><strong>So that I </strong>can confirm whether=
 the Visa debit transaction can be disputed.</p></td>
<td data-local-id=3D"07b4471b62b1" class=3D"confluenceTd">
<p local-id=3D"04f1351b57a4">Ability to confirm the validation method used =
for a transaction (ie 3DS authentication, Token Authentication Verification=
 Value (TAVV), or Electronic Commerce Indicator (ECI) 5 authentication).</p=
></td>
<td data-local-id=3D"1556e11e6544" class=3D"confluenceTd">
<p local-id=3D"0bcafb78df27">Disputes are invalid when txns were authentica=
ted through successful validation.</p></td>
<td data-local-id=3D"d193a7d7b7e3" class=3D"confluenceTd">
<p local-id=3D"5c1a5842211d"></p></td>
<td data-local-id=3D"eed5b0ca57f1" class=3D"confluenceTd">
<p local-id=3D"31770c884ff0"></p></td>
<td data-local-id=3D"bae8b2dee29e" class=3D"confluenceTd">
<p local-id=3D"aa14158e7611"></p></td>
</tr>
</tbody>
</table>
</div>
</div>
</div>
<h3 local-id=3D"4d9b435c5338" id=3D"PRD|ProductRequirementsDocument:VisaDeb=
itCards-6.FraudManagement">6. Fraud Management</h3>
<div id=3D"expander-1852879339" class=3D"expand-container">
<div id=3D"expander-control-1852879339" class=3D"expand-control">
<span class=3D"expand-control-icon"><img style=3D"vertical-align:middle;" c=
lass=3D"expand-control-image" src=3D"c07bcdf0ced7b4d9093bebfbefa7168e923321=
ffd7300a885255d320adb1d0df" width=3D"16" height=3D"16"></span><span class=
=3D"expand-control-text">Functional Requirements &amp; Acceptance Criteria<=
/span>
</div>
<div id=3D"expander-content-1852879339" class=3D"expand-content">
<div class=3D"table-wrap">
<table data-table-width=3D"4000" data-layout=3D"align-start" data-local-id=
=3D"a8622a7d-0d12-4491-809e-f1827e893360" class=3D"confluenceTable">
<colgroup>
<col style=3D"width: 224.0px;">
<col style=3D"width: 129.0px;">
<col style=3D"width: 174.0px;">
<col style=3D"width: 182.0px;">
<col style=3D"width: 84.0px;">
<col style=3D"width: 91.0px;">
<col style=3D"width: 148.0px;">
</colgroup>
<tbody>
<tr data-local-id=3D"ca3b0f876119">
<th data-local-id=3D"7dbd0ff0219e" class=3D"confluenceTh">
<p local-id=3D"9164b33b9802"></p>
<p local-id=3D"735ba888315b"><strong>#</strong></p></th>
<th data-local-id=3D"4eef36d86ff6" class=3D"confluenceTh">
<p local-id=3D"133f6b99c351"><strong>User Story</strong></p></th>
<th data-local-id=3D"233b9579b718" class=3D"confluenceTh">
<p local-id=3D"2b45e09e2106"><strong>Functional Requirement</strong></p></t=
h>
<th data-local-id=3D"467d7ec7adb5" class=3D"confluenceTh">
<p local-id=3D"4ec6f0c90588"><strong>Acceptance Criteria</strong></p></th>
<th data-local-id=3D"c6a298dfb1ed" class=3D"confluenceTh">
<p local-id=3D"9bb30eef2db0"><strong>Owner / Teams</strong></p></th>
<th data-local-id=3D"cda8897b7f09" class=3D"confluenceTh">
<p local-id=3D"b43d6ef2587d"><strong>Priority</strong></p></th>
<th data-local-id=3D"1e978b2891a0" class=3D"confluenceTh">
<p local-id=3D"686b8701e12d"><strong>Jira</strong></p></th>
</tr>
<tr data-local-id=3D"eed8ce73ff8c">
<td data-local-id=3D"4596d9d34e16" class=3D"confluenceTd">
<p local-id=3D"aace2c2fc6c0"></p></td>
<td data-local-id=3D"baa9172f9cfd" class=3D"confluenceTd">
<p local-id=3D"6a1976a42e54"></p></td>
<td data-local-id=3D"beccea4bdf00" class=3D"confluenceTd">
<p local-id=3D"b0c6284af8eb">System must support ingestion of CAMS alerts (=
compromised account notifications)to block card.</p></td>
<td data-local-id=3D"4ca8715c2346" class=3D"confluenceTd">
<p local-id=3D"14aae3fa5207">Everlink will distribute alert details. Cards =
will be temporarily blocked by EVL on the switch within 24 hours.</p></td>
<td data-local-id=3D"3ab846ecb0e1" class=3D"confluenceTd">
<p local-id=3D"ea974b861932"></p></td>
<td data-local-id=3D"dde60b1489c1" class=3D"confluenceTd">
<p local-id=3D"c4c06cfa9439"></p></td>
<td data-local-id=3D"f033f94c1fc4" class=3D"confluenceTd">
<p local-id=3D"3af25bd5ae62"></p></td>
</tr>
<tr data-local-id=3D"c00a986f3f7e">
<td data-local-id=3D"f5bdf50cd656" class=3D"confluenceTd">
<p local-id=3D"7102049e1339"></p></td>
<td data-local-id=3D"48e40cb14679" class=3D"confluenceTd">
<p local-id=3D"3c45498d65c8"></p></td>
<td data-local-id=3D"1eeb4adbb131" class=3D"confluenceTd">
<p local-id=3D"d4e43cc9f787">Ability to unblock card that was blocked by EV=
L switch via compromised account notification.</p></td>
<td data-local-id=3D"9b74c026ee6e" class=3D"confluenceTd">
<p local-id=3D"1c0e0c299f3d"></p></td>
<td data-local-id=3D"721353e6461b" class=3D"confluenceTd">
<p local-id=3D"8b0ed91f3eaa"></p></td>
<td data-local-id=3D"1f16ab393717" class=3D"confluenceTd">
<p local-id=3D"2fa81b58d52d"></p></td>
<td data-local-id=3D"5560c16f56f3" class=3D"confluenceTd">
<p local-id=3D"98042249223d"></p></td>
</tr>
<tr data-local-id=3D"1ad7313b1428">
<td data-local-id=3D"af30e14d105a" class=3D"confluenceTd">
<p local-id=3D"6e6f7d1b1353"></p></td>
<td data-local-id=3D"635222e9b62b" class=3D"confluenceTd">
<p local-id=3D"5d172d7cc916"></p></td>
<td data-local-id=3D"3579aae92990" class=3D"confluenceTd">
<p local-id=3D"ab942d0e6998">System must support blocking of lost/stolen ca=
rds and fraud alerts via Global Customer Assistance Services (GCAS) process=
es</p></td>
<td data-local-id=3D"79c9764c4e0c" class=3D"confluenceTd">
<p local-id=3D"fa432baae19d"></p></td>
<td data-local-id=3D"16ecaed5bc74" class=3D"confluenceTd">
<p local-id=3D"2002511e5baa"></p></td>
<td data-local-id=3D"b3bc8c6ddd1b" class=3D"confluenceTd">
<p local-id=3D"6a9e1c34fe51"></p></td>
<td data-local-id=3D"13f44a47cc4b" class=3D"confluenceTd">
<p local-id=3D"f3f746fcf93c"></p></td>
</tr>
<tr data-local-id=3D"d09ead66803d">
<td data-local-id=3D"00db40ea3555" class=3D"confluenceTd">
<p local-id=3D"3ebf6e12bbb1"></p></td>
<td data-local-id=3D"997dc9abcc2c" class=3D"confluenceTd">
<p local-id=3D"1a400c75726d"></p></td>
<td data-local-id=3D"c9d1b2e6660a" class=3D"confluenceTd">
<p local-id=3D"d3fa6ae613a0">Ability to unblock transaction via Visa Consum=
er Authentication Service (VCAS) that failed multiple 3DS One Time Password=
 (OTP) authentication attempts.</p></td>
<td data-local-id=3D"c4d4fd81f5f4" class=3D"confluenceTd">
<p local-id=3D"a40439bbfce0">Requires role-restricted admin unblock authori=
zation</p></td>
<td data-local-id=3D"ac864d2ffa83" class=3D"confluenceTd">
<p local-id=3D"a8e66157ab88"></p></td>
<td data-local-id=3D"336be4d45882" class=3D"confluenceTd">
<p local-id=3D"907e4f3b5c3a"></p></td>
<td data-local-id=3D"267f046560c7" class=3D"confluenceTd">
<p local-id=3D"b19428535c48"></p></td>
</tr>
<tr data-local-id=3D"7424c3e73e22">
<td data-local-id=3D"215eac80be24" class=3D"confluenceTd">
<p local-id=3D"85fd10f88a93"></p></td>
<td data-local-id=3D"fd4ff5036491" class=3D"confluenceTd">
<p local-id=3D"aae580728f17"></p></td>
<td data-local-id=3D"a243552a12c5" class=3D"confluenceTd">
<p local-id=3D"f246cb81b8c4">Ability to bypass a declined authentication pr=
ocess where step up authentication is not possible (10 minutes, 1 hour or 1=
 day) to allow cardholder requests to be processed.</p></td>
<td data-local-id=3D"56783a73fc4b" class=3D"confluenceTd">
<p local-id=3D"731370c406ef">Used when a cardholder is being declined becau=
se they are unable to receive the OTP.</p></td>
<td data-local-id=3D"2eb7db835ca3" class=3D"confluenceTd">
<p local-id=3D"9d6ff0b196a7"></p></td>
<td data-local-id=3D"eb10d77d97b0" class=3D"confluenceTd">
<p local-id=3D"ed3e111e5453"></p></td>
<td data-local-id=3D"1b652248ac24" class=3D"confluenceTd">
<p local-id=3D"494da12957ca"></p></td>
</tr>
</tbody>
</table>
</div>
</div>
</div>
<h3 local-id=3D"d1f9625ed0a2" id=3D"PRD|ProductRequirementsDocument:VisaDeb=
itCards-7.DataReporting">7. Data Reporting</h3>
<div id=3D"expander-878312227" class=3D"expand-container">
<div id=3D"expander-control-878312227" class=3D"expand-control">
<span class=3D"expand-control-icon"><img style=3D"vertical-align:middle;" c=
lass=3D"expand-control-image" src=3D"c07bcdf0ced7b4d9093bebfbefa7168e923321=
ffd7300a885255d320adb1d0df" width=3D"16" height=3D"16"></span><span class=
=3D"expand-control-text">Functional Requirements &amp; Acceptance Criteria<=
/span>
</div>
<div id=3D"expander-content-878312227" class=3D"expand-content">
<div class=3D"table-wrap">
<table data-table-width=3D"4000" data-layout=3D"align-start" data-local-id=
=3D"b15db5c0-e8b8-4dc6-b9e3-a21c72fc43ce" class=3D"confluenceTable">
<colgroup>
<col style=3D"width: 62.0px;">
<col style=3D"width: 260.0px;">
<col style=3D"width: 203.0px;">
<col style=3D"width: 224.0px;">
<col style=3D"width: 114.0px;">
<col style=3D"width: 83.0px;">
<col style=3D"width: 86.0px;">
</colgroup>
<tbody>
<tr data-local-id=3D"69787a54a37d">
<th data-local-id=3D"dfed52da9d0c" class=3D"confluenceTh">
<p local-id=3D"30a6d2a68431"><strong>#</strong></p></th>
<th data-local-id=3D"76be065da573" class=3D"confluenceTh">
<p local-id=3D"644237e8801e"><strong>User Story</strong></p></th>
<th data-local-id=3D"e63f5f058ede" class=3D"confluenceTh">
<p local-id=3D"22234081be54"><strong>Functional Requirement</strong></p></t=
h>
<th data-local-id=3D"0dd1ae93f005" class=3D"confluenceTh">
<p local-id=3D"0be0d159cd3a"><strong>Acceptance Criteria</strong></p></th>
<th data-local-id=3D"677985707b3b" class=3D"confluenceTh">
<p local-id=3D"9b4571dceda9"><strong>Owner/Teams</strong></p></th>
<th data-local-id=3D"6e8368a1b6be" class=3D"confluenceTh">
<p local-id=3D"49b6300a3eda"><strong>Priority</strong></p></th>
<th data-local-id=3D"261542720179" class=3D"confluenceTh">
<p local-id=3D"556993eac5ae"><strong>Jira</strong></p></th>
</tr>
<tr data-local-id=3D"0b8a556c469f">
<td data-local-id=3D"eb3a4624655f" class=3D"confluenceTd">
<p local-id=3D"4ce2be9e2145"></p></td>
<td data-local-id=3D"f8b38b75bb9a" class=3D"confluenceTd">
<p local-id=3D"007a2708edfe"></p></td>
<td data-local-id=3D"b04fc5ad72ef" class=3D"confluenceTd">
<p local-id=3D"34aa2e748b81">Ability to report on overall revenue and cost =
of Visa Debit cards which includes a breakdown of Interchange Fees (IF) and=
 Optional Issuer Fees (OIF).</p></td>
<td data-local-id=3D"d3419d5ff097" class=3D"confluenceTd">
<p local-id=3D"b371b5e84f65"></p></td>
<td data-local-id=3D"b7e1fc66adbe" class=3D"confluenceTd">
<p local-id=3D"1c9a6af22252"></p></td>
<td data-local-id=3D"7058a3167eaf" class=3D"confluenceTd">
<p local-id=3D"d63e2d4074cc"></p></td>
<td data-local-id=3D"db6fb25c3a52" class=3D"confluenceTd">
<p local-id=3D"b3e67b6f4560"></p></td>
</tr>
<tr data-local-id=3D"60fb227b699a">
<td data-local-id=3D"d89c272f1ce8" class=3D"confluenceTd">
<p local-id=3D"1700caf401fb"></p></td>
<td data-local-id=3D"3f9eac0292ca" class=3D"confluenceTd">
<p local-id=3D"0e81200ab7c8"></p></td>
<td data-local-id=3D"0d3a0385f2bf" class=3D"confluenceTd">
<p local-id=3D"f8b2d7edb76b">Monthly Visa Operating Certificate (VOC) repor=
ting must be supported, including purchase volume, active cards/accounts, a=
nd fraud losses; reports must be submitted the 1<sup>st</sup> business day =
of each month.</p></td>
<td data-local-id=3D"24588ab11403" class=3D"confluenceTd">
<p local-id=3D"b5fa480352e5"></p></td>
<td data-local-id=3D"6d03ff14fa32" class=3D"confluenceTd">
<p local-id=3D"b7ecf28242e4">Business Solutions</p>
<p local-id=3D"a137d4e0c7c4">Angela Fraser</p>
<p local-id=3D"8f5b95fbfaf8">Dawn Collins</p></td>
<td data-local-id=3D"4654c097c0c0" class=3D"confluenceTd">
<p local-id=3D"8b5edaba003b"></p></td>
<td data-local-id=3D"41158b109796" class=3D"confluenceTd">
<p local-id=3D"c19698db1d29"></p></td>
</tr>
<tr data-local-id=3D"26ae72583526">
<td data-local-id=3D"2d86591b4aad" class=3D"confluenceTd">
<p local-id=3D"0bc947b339d8"></p></td>
<td data-local-id=3D"744f36f794b9" class=3D"confluenceTd">
<p local-id=3D"ec4ecdfe02ff"></p></td>
<td data-local-id=3D"1fce56dacb83" class=3D"confluenceTd">
<p local-id=3D"fa73498ecb18">Daily file exchange for Visa Account Updater (=
VAU) must be supported, including PAN, expiry date, and card updates for da=
ily submission.(AT_EVERLINKVAU)</p></td>
<td data-local-id=3D"052130c53776" class=3D"confluenceTd">
<p local-id=3D"bfbdda9fcb91">1 - Closed Account</p>
<p local-id=3D"c9a86233f029">2 - Expiration Date Change</p>
<p local-id=3D"2356ab06897d">3- Cardholder Opt Out</p>
<p local-id=3D"57a93321e1c3">4 - Cardholder Opt In</p>
<p local-id=3D"7367050d658c">Confirm masking of PAN</p></td>
<td data-local-id=3D"3cc636f5d769" class=3D"confluenceTd">
<p local-id=3D"aab8bed34630">Business Solutions</p>
<p local-id=3D"e525ce0168de">Angela Fraser</p>
<p local-id=3D"8d4adeda6700">Dawn Collins</p></td>
<td data-local-id=3D"52d04cdd6c92" class=3D"confluenceTd">
<p local-id=3D"7a2ef9809b6f"></p></td>
<td data-local-id=3D"eee9a2dae976" class=3D"confluenceTd">
<p local-id=3D"eb8b651270a1"></p></td>
</tr>
<tr data-local-id=3D"b914f6c85c2a">
<td data-local-id=3D"568946074d1f" class=3D"confluenceTd">
<p local-id=3D"d2e6896b3360"></p></td>
<td data-local-id=3D"4723b4c74c79" class=3D"confluenceTd">
<p local-id=3D"85d55b12f3d3"></p></td>
<td data-local-id=3D"5b12123ecef7" class=3D"confluenceTd">
<p local-id=3D"f7cef985ea9c">Tracking and monitoring of chargeback ratios v=
s. Visa thresholds</p></td>
<td data-local-id=3D"9a8a29aae06b" class=3D"confluenceTd">
<p local-id=3D"18dfdca9f1b4">Chargeback ratio calculated daily with 100% ac=
curacy and monitored against Visa thresholds; alerts triggered within 24 ho=
urs when thresholds are breached</p></td>
<td data-local-id=3D"7a20d74563b4" class=3D"confluenceTd">
<p local-id=3D"d0b73bf39395"></p></td>
<td data-local-id=3D"8282ba585ad4" class=3D"confluenceTd">
<p local-id=3D"9776a10b02de"></p></td>
<td data-local-id=3D"df035d0a7064" class=3D"confluenceTd">
<p local-id=3D"a0ca3d69d59a"></p></td>
</tr>
<tr data-local-id=3D"67f787f86a54">
<td data-local-id=3D"5af3864eda43" class=3D"confluenceTd">
<p local-id=3D"d62084453a7f"></p></td>
<td data-local-id=3D"77b190b06948" class=3D"confluenceTd">
<p local-id=3D"9c5e167a3d81"></p></td>
<td data-local-id=3D"0d919cc79472" class=3D"confluenceTd">
<p local-id=3D"8d32fef88592">SEMF file must be supported.</p></td>
<td data-local-id=3D"180a765ffb64" class=3D"confluenceTd">
<p local-id=3D"66e57b1af596">Need to confirm all details on report for accu=
racy with DNA.</p>
<p local-id=3D"3e795f35731d">Need to confirm changes to card details are ca=
ptured.</p></td>
<td data-local-id=3D"abca1f76b7dc" class=3D"confluenceTd">
<p local-id=3D"88f7f16440ee"></p></td>
<td data-local-id=3D"a703128641a6" class=3D"confluenceTd">
<p local-id=3D"2691b9c5fbe1"></p></td>
<td data-local-id=3D"ab4354c11bc7" class=3D"confluenceTd">
<p local-id=3D"3a121d81a0cc"></p></td>
</tr>
<tr data-local-id=3D"fef618bae315">
<td data-local-id=3D"7218f3e439f2" class=3D"confluenceTd">
<p local-id=3D"e23a87962f3d"></p></td>
<td data-local-id=3D"d52c86cd682d" class=3D"confluenceTd">
<p local-id=3D"3d527aac499e"></p></td>
<td data-local-id=3D"ae88abb914b3" class=3D"confluenceTd">
<p local-id=3D"4d25d6741b80">Ability to support Fintrac Reporting</p></td>
<td data-local-id=3D"4328dcb991ec" class=3D"confluenceTd">
<p local-id=3D"0f0d9f02b48a">Report AT_FINTRAC has been enabled for Visa De=
bit. It is still TBD whether this will be used.</p></td>
<td data-local-id=3D"ecca29951dee" class=3D"confluenceTd">
<p local-id=3D"97361da277f2"></p></td>
<td data-local-id=3D"7a409293c1b5" class=3D"confluenceTd">
<p local-id=3D"1b8929108b4f"></p></td>
<td data-local-id=3D"7656405d5023" class=3D"confluenceTd">
<p local-id=3D"24eb04eb957e"></p></td>
</tr>
</tbody>
</table>
