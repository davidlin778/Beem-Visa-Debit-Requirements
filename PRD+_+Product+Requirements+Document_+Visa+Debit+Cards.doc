<p local-id=3D"1dfb2fcd33bd">3.11</p></td>
<td data-local-id=3D"5cd7b773f0fd" class=3D"confluenceTd">
<p local-id=3D"dd1a81976a18">Stand-In Processing</p></td>
<td data-local-id=3D"286127858223" class=3D"confluenceTd">
<p local-id=3D"e36ee930868f">Authorization interruption events generate ope=
rational alerts and audit records</p></td>
<td data-local-id=3D"f6579dfbb146" class=3D"confluenceTd">
<p local-id=3D"aa6dd43c7e9a"><em>100% interruption events generate alert wi=
thin 60 seconds</em></p></td>
<td data-local-id=3D"8834c7205291" class=3D"confluenceTd">
<p local-id=3D"250637c20abc"></p></td>
<td data-local-id=3D"ff9d2c657495" class=3D"confluenceTd">
