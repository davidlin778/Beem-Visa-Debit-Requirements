<tr data-local-id=3D"d53950f54018">
<td data-local-id=3D"3f2877774109" class=3D"confluenceTd">
<p local-id=3D"9debd360c1a4">2.1</p></td>
<td data-local-id=3D"6c153a9c083d" class=3D"confluenceTd">
<p local-id=3D"1a51496afaed">Data Confidentiality</p></td>
<td data-local-id=3D"947e2835f529" class=3D"confluenceTd">
<p local-id=3D"212d0f6be43d">All confidential information, including operat=
ional, financial, and customer data, must be protected against unauthorized=
 disclosure and handled per contractual confidentiality obligations</p></td=
>
<td data-local-id=3D"776884c0d6fa" class=3D"confluenceTd">
<p local-id=3D"9111e645c5d8"><em>0 unauthorized data exposure incidents</em=
></p></td>
